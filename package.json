{
  "name": "ngx-lite-gantt",
  "version": "0.1.0",
  "description": "Diagrama de Gantt ligero y standalone para Angular, sin dependencias de UI y personalizable con variables CSS.",
  "license": "MIT",
  "author": "Nacho Tamayo",
  "repository": {
    "type": "git",
    "url": "https://github.com/NachoTamayo/ngx-lite-gantt.git"
  },
  "keywords": ["angular", "gantt", "timeline", "planning", "standalone-component"],
  "private": true,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0"
  },
  "devDependencies": {
    "@angular/common": "~20.3.0",
    "@angular/compiler": "~20.3.0",
    "@angular/compiler-cli": "~20.3.0",
    "@angular/core": "~20.3.0",
    "@angular/platform-browser": "~20.3.0",
    "@angular/platform-browser-dynamic": "~20.3.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.6.2",
    "ng-packagr": "~20.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "zone.js": "~0.15.1"
  }
}
